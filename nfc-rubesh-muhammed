<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#101c32">
<meta name="description" content="Mohammed Rubesh — Founder & CEO, Ekal Ventures and Palmeryn Estates.">
<title>Mohammed Rubesh | Interactive NFC Card</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet">
<style>
:root{--navy:#101c32;--navy2:#1b2b46;--gold:#c6a56e;--gold2:#9c7b48;--ivory:#f6f1e7;--paper:#fffdf8;--emerald:#176b57;--muted:#687184}
*{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;min-height:100vh;background:radial-gradient(circle at 10% 10%,rgba(198,165,110,.18),transparent 27%),radial-gradient(circle at 92% 82%,rgba(23,107,87,.09),transparent 26%),var(--ivory);color:var(--navy);font-family:"DM Sans",sans-serif;display:flex;align-items:center;justify-content:center;padding:28px 15px;overflow-x:hidden}
.stage{width:min(100%,440px);perspective:1400px}
.intro{text-align:center;margin-bottom:19px}
.brand{font:800 15px Manrope,sans-serif;letter-spacing:-.07em;color:var(--navy)}
.brand span{color:var(--gold2)}
.intro p{font-size:9px;letter-spacing:.2em;text-transform:uppercase;color:#84785f;margin:7px 0 0}
.flip-wrap{position:relative;width:100%;height:610px;perspective:1400px;cursor:pointer;outline:none}
.flip-card{position:relative;width:100%;height:100%;transform-style:preserve-3d;transition:transform .9s cubic-bezier(.2,.72,.2,1);border-radius:4px}
.flip-wrap.is-flipped .flip-card{transform:rotateY(180deg)}
.face{position:absolute;inset:0;backface-visibility:hidden;-webkit-backface-visibility:hidden;overflow:hidden;border:1px solid rgba(198,165,110,.7);background:var(--paper);box-shadow:0 28px 80px rgba(16,28,50,.18);border-radius:4px}
.front{background:linear-gradient(155deg,var(--navy),#172842 70%,#20334c);color:var(--ivory);display:flex;flex-direction:column;align-items:center;text-align:center;padding:30px 26px 23px}
.front:before,.front:after{content:"";position:absolute;border:1px solid rgba(198,165,110,.25);border-radius:50%;width:390px;height:390px;top:-235px;left:50%;transform:translateX(-50%);pointer-events:none}
.front:after{width:315px;height:315px;top:-197px;border-color:rgba(198,165,110,.17)}
.corner{position:absolute;width:48px;height:48px;border-color:var(--gold);opacity:.8}
.corner.tl{top:13px;left:13px;border-top:1px solid;border-left:1px solid}
.corner.tr{top:13px;right:13px;border-top:1px solid;border-right:1px solid}
.corner.bl{bottom:13px;left:13px;border-bottom:1px solid;border-left:1px solid}
.corner.br{bottom:13px;right:13px;border-bottom:1px solid;border-right:1px solid}
.monogram{font:600 12px Manrope,sans-serif;letter-spacing:.2em;color:var(--gold);position:relative;z-index:1}
.photo-ring{width:150px;height:174px;margin:37px auto 22px;padding:5px;border:1px solid var(--gold);background:rgba(255,255,255,.07);position:relative;z-index:1;box-shadow:0 14px 36px rgba(0,0,0,.2)}
.photo-ring img{width:100%;height:100%;object-fit:cover;object-position:center 24%;display:block}
.name{font:600 clamp(29px,8vw,36px)/1.03 Manrope,sans-serif;letter-spacing:-.075em;color:#fff;margin:0}
.title{font-size:11px;color:#e7d7b8;font-weight:700;margin-top:11px}
.companies{font-size:10px;color:#c7ced7;margin-top:5px}
.motto{font:italic 15px/1.6 "Playfair Display",serif;color:#d7c8ac;margin:22px 0 0;max-width:285px}
.front-bottom{margin-top:auto;display:flex;align-items:center;justify-content:space-between;width:100%;border-top:1px solid rgba(198,165,110,.35);padding-top:15px;color:#c5b18d;font-size:8px;letter-spacing:.16em;text-transform:uppercase}
.tap-hint{display:flex;align-items:center;gap:7px;color:#fff;font-size:9px;letter-spacing:.13em;text-transform:uppercase}
.tap-hint b{display:grid;place-items:center;width:21px;height:21px;border:1px solid rgba(198,165,110,.7);border-radius:50%;font-size:12px;color:var(--gold)}
.back{transform:rotateY(180deg);display:flex;flex-direction:column;background:var(--paper);color:var(--navy)}
.back-head{padding:22px 24px 17px;background:var(--navy);color:var(--ivory);position:relative;overflow:hidden}
.back-head:after{content:"";position:absolute;width:210px;height:210px;border:1px solid rgba(198,165,110,.22);border-radius:50%;right:-100px;top:-130px}
.back-head small{font-size:8px;letter-spacing:.2em;color:var(--gold);text-transform:uppercase}
.back-head h2{font:600 23px Manrope,sans-serif;letter-spacing:-.06em;margin:8px 0 4px}
.back-head p{font-size:10px;color:#c9d0d8;margin:0}
.back-content{padding:13px 23px;display:flex;flex-direction:column;gap:0;flex:1}
.contact{display:flex;align-items:center;gap:12px;padding:11px 0;border-bottom:1px solid rgba(16,28,50,.09);text-decoration:none;color:var(--navy);min-height:53px}
.contact:last-of-type{border-bottom:0}
.contact-icon{width:30px;height:30px;display:grid;place-items:center;border-radius:50%;background:#eee7da;color:var(--gold2);font-size:13px;flex:0 0 auto}
.contact span.label{display:block;font-size:8px;letter-spacing:.08em;color:#7c8190;text-transform:uppercase;margin-bottom:3px}
.contact strong{font:700 10px Manrope,sans-serif;overflow-wrap:anywhere}
.contact .arr{margin-left:auto;color:var(--gold2)}
.back-bottom{margin-top:auto;padding:13px 23px 18px;background:#f1ebdf}
.qr-row{display:flex;align-items:center;gap:13px}
.qr-row img{width:83px;height:83px;padding:5px;background:#fff;border:1px solid rgba(198,165,110,.65)}
.qr-copy{flex:1}
.qr-copy small{font-size:8px;color:var(--gold2);letter-spacing:.16em;text-transform:uppercase}
.qr-copy strong{display:block;font:700 11px Manrope,sans-serif;margin:5px 0}
.qr-copy a{font-size:9px;color:var(--emerald);text-decoration:none;font-weight:700}
.back-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:13px}
.back-actions button{padding:11px 7px;border:1px solid rgba(16,28,50,.2);background:transparent;color:var(--navy);font:700 8px Manrope,sans-serif;letter-spacing:.07em;text-transform:uppercase;cursor:pointer;transition:.25s}
.back-actions button:first-child{background:var(--navy);border-color:var(--navy);color:var(--ivory)}
.back-actions button:hover{transform:translateY(-2px);border-color:var(--gold)}
.flip-back-hint{text-align:center;padding:11px;background:#fffdf8;color:#88785d;font-size:8px;letter-spacing:.14em;text-transform:uppercase;border-top:1px solid rgba(198,165,110,.25)}
.below{text-align:center;margin-top:18px;color:#827861;font-size:9px;letter-spacing:.08em}
.below strong{color:var(--navy)}
.flip-wrap:hover .face{box-shadow:0 34px 90px rgba(16,28,50,.22)}
@media(max-width:390px){.flip-wrap{height:590px}.front{padding:25px 19px 20px}.photo-ring{width:135px;height:157px;margin-top:32px}.back-head{padding:19px 19px 14px}.back-content{padding:9px 18px}.back-bottom{padding:11px 18px 15px}.contact{min-height:49px}}
@media(prefers-reduced-motion:reduce){.flip-card{transition:none}*{scroll-behavior:auto!important}}
</style>
</head>
<body>
<main class="stage">
 <header class="intro"><div class="brand">MR<span>.</span></div><p>Tap the card to turn · Digital profile</p></header>
 <div class="flip-wrap" id="flipWrap" role="button" tabindex="0" aria-label="Flip digital business card" aria-pressed="false">
  <div class="flip-card">
   <section class="face front" aria-label="Front of business card">
    <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
    <div class="monogram">A LIFE ACROSS HORIZONS</div>
    <div class="photo-ring"><img src="data:image/jpeg;base64," alt="Mohammed Rubesh"></div>
    <h1 class="name">Mohammed<br>Rubesh</h1>
    <div class="title">FOUNDER &amp; CEO</div>
    <div class="companies">Ekal Ventures &nbsp;·&nbsp; Palmeryn Estates</div>
    <p class="motto">Experience. Leadership. Entrepreneurship.</p>
    <div class="front-bottom"><span>Personal digital card</span><span class="tap-hint"><b>↻</b> Tap to flip</span></div>
   </section>
   <section class="face back" aria-label="Back of business card">
    <div class="back-head"><small>Connect professionally</small><h2>Let's stay connected.</h2><p>Mohammed Rubesh · Founder &amp; CEO</p></div>
    <div class="back-content">
     <a class="contact" href="tel:+919847818508"><span class="contact-icon">☎</span><span><span class="label">Phone</span><strong>+91 98478 18508</strong></span><span class="arr">↗</span></a>
     <a class="contact" href="https://wa.me/919847818508" target="_blank" rel="noopener"><span class="contact-icon">◉</span><span><span class="label">WhatsApp</span><strong>Message on WhatsApp</strong></span><span class="arr">↗</span></a>
     <a class="contact" href="mailto:mohdrubesh2022@gmail.com"><span class="contact-icon">✉</span><span><span class="label">Email</span><strong>mohdrubesh2022@gmail.com</strong></span><span class="arr">↗</span></a>
     <a class="contact" href="https://www.linkedin.com/in/rubesh-mohammed" target="_blank" rel="noopener"><span class="contact-icon">in</span><span><span class="label">LinkedIn</span><strong>Connect on LinkedIn</strong></span><span class="arr">↗</span></a>
     <a class="contact" href="https://rubeshernikhal.com" target="_blank" rel="noopener"><span class="contact-icon">↗</span><span><span class="label">Personal website</span><strong>rubeshernikhal.com</strong></span><span class="arr">↗</span></a>
    </div>
    <div class="back-bottom">
     <div class="qr-row"><img src="data:image/png;base64," alt="QR code linking to Rubesh's website"><div class="qr-copy"><small>Scan to explore</small><strong>My personal website</strong><a href="https://rubeshernikhal.com" target="_blank" rel="noopener">rubeshernikhal.com ↗</a></div></div>
     <div class="back-actions"><button type="button" id="saveContact">↓ &nbsp; Save contact</button><button type="button" id="shareCard">↗ &nbsp; Share card</button></div>
    </div>
    <div class="flip-back-hint">Tap anywhere outside a link to return to front</div>
   </section>
  </div>
 </div>
 <div class="below">A refined introduction to <strong>Mohammed Rubesh</strong></div>
</main>
<script>
const wrap=document.getElementById('flipWrap');
function flip(){const state=wrap.classList.toggle('is-flipped');wrap.setAttribute('aria-pressed',String(state));}
wrap.addEventListener('click',e=>{if(e.target.closest('a,button'))return;flip();});
wrap.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();flip();}});
document.getElementById('saveContact').addEventListener('click',e=>{
 e.stopPropagation();
 const v=['BEGIN:VCARD','VERSION:3.0','N:Muhammed;Rubesh;;;','FN:Mohammed Rubesh','TITLE:Founder & CEO','ORG:Ekal Ventures; Palmeryn Estates','TEL;TYPE=CELL,VOICE:+919847818508','EMAIL:mohdrubesh2022@gmail.com','URL:https://rubeshernikhal.com','NOTE:Founder & CEO of Ekal Ventures and Palmeryn Estates','END:VCARD'].join('\r\n');
 const blob=new Blob([v],{type:'text/vcard;charset=utf-8'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='Mohammed-Rubesh.vcf';document.body.appendChild(a);a.click();a.remove();URL.revokeObjectURL(url);
});
document.getElementById('shareCard').addEventListener('click',async e=>{
 e.stopPropagation();const data={title:'Mohammed Rubesh | Digital Business Card',text:'Founder & CEO · Ekal Ventures & Palmeryn Estates',url:window.location.href};
 try{if(navigator.share)await navigator.share(data);else if(navigator.clipboard){await navigator.clipboard.writeText(window.location.href);alert('Digital card link copied.');}}catch(err){}
});
</script>
</body></html>
